# ── зависимости и сборка ───────────────────────────────────────────────────
node_modules/
dist/
.output/
.nuxt/
.turbo/
*.tsbuildinfo
coverage/

# ── секреты ────────────────────────────────────────────────────────────────
# `.env` держит пароль входа, ключ шифрования и секрет сессии. В репозиторий
# едет только `.env.example` с пустыми значениями.
.env
.env.*
!.env.example
secrets/
# настоящий конфиг туннеля: в нём адрес, идентификатор и путь к ключам
# список своих опознавателей для проверки перед коммитом — он и сам не для git
.scan-local.json
*.pem
*.key
*.p12
*.pfx
id_rsa*

# ── чужие данные ───────────────────────────────────────────────────────────
# Выгрузка Apple Health — это история здоровья живого человека, а дампы базы и
# собранные файлы содержат её дневник питания целиком. Ни то, ни другое не
# место в репозитории, даже приватном (D-057).
apple-health/
storage/
backup-*/
*.sql
*.sqlite
*.sqlite3
*.dump

# ── временное ──────────────────────────────────────────────────────────────
shots/
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
