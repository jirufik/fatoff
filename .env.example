# ─────────────────────────────────────────────────────────────────────────────
#  FatOff — шаблон конфигурации
#
#  Скопировать в .env и заполнить три обязательных поля: APP_PASSWORD,
#  SESSION_SECRET, SECRETS_KEY. Без них сервис не стартует.
#
#  Относительные пути считаются от рабочего каталога backend — apps/api.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4090
LOG_LEVEL=info                        # fatal | error | warn | info | debug | trace

# ── доступ в сервис ──────────────────────────────────────────────────────────
APP_PASSWORD=                         # ЗАПОЛНИТЬ: пароль для входа в WEB-интерфейс
SESSION_SECRET=                       # ЗАПОЛНИТЬ: случайная строка, минимум 16 символов
SESSION_TTL_DAYS=30
COOKIE_SECURE=false                   # true, если сервис за HTTPS

# ── шифрование учётных данных YAZIO ──────────────────────────────────────────
# 32 байта в hex. Сгенерировать: openssl rand -hex 32
# Ключ живёт здесь, а не в базе: дамп базы без него бесполезен (D-004).
SECRETS_KEY=                          # ЗАПОЛНИТЬ: 64 hex-символа

# ── база данных ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5483                          # база develop; прод живёт на 5482 (D-057)
DB_NAME=fatoff
DB_USER=fatoff
DB_PASSWORD=fatoff
DB_DEBUG=false
DB_AUTO_MIGRATE=true                  # применять миграции при старте

# ── API YAZIO ────────────────────────────────────────────────────────────────
YAZIO_API_BASE=https://yzapi.yazio.com
YAZIO_API_VERSION=v9                  # v22 проверяет версию клиента и может закрыться (D-002)
YAZIO_CONCURRENCY=6                   # одновременных запросов к YAZIO
YAZIO_RESYNC_DAYS=3                   # хвост дней, который перекачивается всегда
YAZIO_TIMEOUT_MS=30000

# ── Apple Health ─────────────────────────────────────────────────────────────
# Каталог, куда положена выгрузка Apple Health (файл экспорт.xml).
# Через браузер такой файл не загрузить — сервис читает его с диска.
GOOGLE_SERVICE_ACCOUNT_FILE=../../secrets/service-account.json   # путь от apps/api; папку тогда можно не делать публичной
GOOGLE_API_KEY=                       # ключ Google API для чтения публичной папки Drive

HEALTH_DIR=../../apple-health

# ── выгрузки ─────────────────────────────────────────────────────────────────
EXPORT_DIR=../../storage/exports
EXPORT_RETENTION_DAYS=30              # 0 — хранить бессрочно

# ── расписание ───────────────────────────────────────────────────────────────
SCHEDULES_ENABLED=false               # локально расписания не нужны: прод их и так ведёт

# ── доска задач на Google Drive (D-071) ──────────────────────────────────────
# Идентификаторы берутся из адресов папок и документов в браузере.
# Сервисный аккаунт не может владеть файлами (квота 0), поэтому документ задач
# создаёт человек, а сервис только правит его содержимое.
DRIVE_FATOFF_FOLDER=                  # корневая папка проекта на Drive
DRIVE_TASKS_FOLDER=                   # папка tasks внутри неё: статус задачи — в имени папки
DRIVE_NOTES_DOC=                      # документ, куда пишут замечания
DRIVE_TASKS_DOC=                      # документ доски задач; создаётся человеком, ведётся сервисом
